# Copy to .env for local development (cwd = apps/api).
# Password hash: uv run python -m app.services.auth
MY_CASTINGS_AUTH_PASSWORD_HASH=
# At least 32 bytes: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MY_CASTINGS_JWT_SECRET=
# Local http://localhost only; leave true anywhere served over HTTPS.
MY_CASTINGS_COOKIE_SECURE=false
# Local media storage (RustFS from docker-compose.yml); on AWS these stay unset.
MY_CASTINGS_S3_ENDPOINT_URL=http://localhost:9000
MY_CASTINGS_S3_ACCESS_KEY_ID=my_castings
MY_CASTINGS_S3_SECRET_ACCESS_KEY=my_castings_local_storage
# MY_CASTINGS_DATABASE_URL=postgresql+psycopg://my_castings:my_castings@localhost:5432/my_castings
